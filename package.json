{
  "name": "crydroid-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "CryDroid Launcher OS \u2014 fully virtualized cryOS phone launcher simulation. One law, many ices.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-store.ts",
    "build:static": "cross-env NEXT_STATIC_EXPORT=1 next build",
    "build:app": "npm run build:static && cap sync android",
    "open:android": "cap open android",
    "build:pages": "cross-env NEXT_STATIC_EXPORT=1 NEXT_BASE_PATH=/cryos-launcher next build && node -e \"require('fs').writeFileSync('out/.nojekyll','')\""
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "next": "15.5.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
